set -e

VERSION="0.1.0"
BUILDDIR="pkg"
SRCDIR="src"
PKGDIR="$BUILDDIR/pkgdir"
STARTDIR="$(pwd)"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

print_success() { echo -e "${GREEN}[✓]${NC} $1"; }
print_error() { echo -e "${RED}[✗]${NC} $1" >&2; }
print_info() { echo -e "${BLUE}[*]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[!]${NC} $1"; }

show_help() {
    cat << EOF
${BOLD}nikaj-build${NC} - Build NikajOS packages from PKGBUILD

${BOLD}Usage:${NC}
    nikaj-build [options]

${BOLD}Options:${NC}
    -h, --help        Show this help message
    -c, --clean       Clean build directory before building
    -i, --install     Install package after building
    -f, --force       Force rebuild even if package exists
    --nodeps          Skip dependency checking
    --noextract       Don't extract sources
    --nobuild         Don't run build() function
    --nocheck         Don't run check() function

${BOLD}Example:${NC}
    cd /path/to/package
    nikaj-build                  # Build package
    nikaj-build -i               # Build and install
    nikaj-build -c -i            # Clean, build, and install

Version: $VERSION
Copyright (c) nikajo14™ (2018)2024-2025
EOF
}

# Parse arguments
CLEAN_BUILD=0
INSTALL_AFTER=0
FORCE_BUILD=0
SKIP_DEPS=0
SKIP_EXTRACT=0
SKIP_BUILD=0
SKIP_CHECK=0

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--clean)
            CLEAN_BUILD=1
            shift
            ;;
        -i|--install)
            INSTALL_AFTER=1
            shift
            ;;
        -f|--force)
            FORCE_BUILD=1
            shift
            ;;
        --nodeps)
            SKIP_DEPS=1
            shift
            ;;
        --noextract)
            SKIP_EXTRACT=1
            shift
            ;;
        --nobuild)
            SKIP_BUILD=1
            shift
            ;;
        --nocheck)
            SKIP_CHECK=1
            shift
            ;;
        *)
            print_error "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Check for PKGBUILD
if [ ! -f "PKGBUILD" ]; then
    print_error "PKGBUILD not found in current directory"
    exit 1
fi

print_info "Building package from PKGBUILD..."
echo ""

# Source PKGBUILD
source PKGBUILD

# Validate required variables
if [ -z "$pkgname" ]; then
    print_error "pkgname not set in PKGBUILD"
    exit 1
fi

if [ -z "$pkgver" ]; then
    print_error "pkgver not set in PKGBUILD"
    exit 1
fi

if [ -z "$pkgrel" ]; then
    pkgrel=1
fi

PKGNAME="$pkgname-$pkgver-$pkgrel"
PKGFILE="$PKGNAME-$(uname -m).nikaj"

print_info "Package: $pkgname"
print_info "Version: $pkgver-$pkgrel"
print_info "Architecture: $(uname -m)"
echo ""

# Check if package already exists
if [ -f "$PKGFILE" ] && [ $FORCE_BUILD -eq 0 ]; then
    print_warning "Package $PKGFILE already exists"
    read -p "Rebuild? [y/N]: " response
    if [ "$response" != "y" ] && [ "$response" != "Y" ]; then
        exit 0
    fi
fi

# Clean build directory
if [ $CLEAN_BUILD -eq 1 ]; then
    print_info "Cleaning build directory..."
    rm -rf "$BUILDDIR" "$SRCDIR"
fi

# Create directories
mkdir -p "$BUILDDIR"
mkdir -p "$SRCDIR"
mkdir -p "$PKGDIR"

# Download sources
if [ -n "$source" ] && [ $SKIP_EXTRACT -eq 0 ]; then
    print_info "Downloading sources..."
    
    for src in "${source[@]}"; do
        filename=$(basename "$src")
        
        if [ -f "$filename" ]; then
            print_success "$filename already downloaded"
        else
            print_info "Downloading $filename..."
            wget -q --show-progress "$src" || {
                print_error "Failed to download $src"
                exit 1
            }
        fi
        
        # Extract if it's an archive
        if [[ "$filename" == *.tar.* ]] || [[ "$filename" == *.tgz ]]; then
            print_info "Extracting $filename..."
            tar -xf "$filename" -C "$SRCDIR"
        fi
    done
fi

# Run prepare() if exists
if declare -f prepare > /dev/null; then
    print_info "Running prepare()..."
    cd "$SRCDIR"
    srcdir="$STARTDIR/$SRCDIR"
    prepare
    cd "$STARTDIR"
fi

# Run build() if exists and not skipped
if declare -f build > /dev/null && [ $SKIP_BUILD -eq 0 ]; then
    print_info "Running build()..."
    cd "$SRCDIR"
    srcdir="$STARTDIR/$SRCDIR"
    build
    cd "$STARTDIR"
fi

# Run check() if exists and not skipped
if declare -f check > /dev/null && [ $SKIP_CHECK -eq 0 ]; then
    print_info "Running check()..."
    cd "$SRCDIR"
    srcdir="$STARTDIR/$SRCDIR"
    check || print_warning "Tests failed (continuing anyway)"
    cd "$STARTDIR"
fi

# Run package() if exists
if declare -f package > /dev/null; then
    print_info "Running package()..."
    cd "$SRCDIR"
    srcdir="$STARTDIR/$SRCDIR"
    pkgdir="$STARTDIR/$PKGDIR"
    package
    cd "$STARTDIR"
else
    print_error "package() function not found in PKGBUILD"
    exit 1
fi

# Create PKGINFO
print_info "Creating PKGINFO..."
cat > "$BUILDDIR/PKGINFO" << EOF
# Package metadata
pkgname = $pkgname
pkgver = $pkgver
pkgrel = $pkgrel
pkgdesc = ${pkgdesc:-}
url = ${url:-}
arch = $(uname -m)
builddate = $(date +%s)
packager = ${PACKAGER:-Unknown Packager}
size = $(du -sb "$PKGDIR" | cut -f1)
EOF

# Add dependencies
if [ -n "$depends" ]; then
    for dep in "${depends[@]}"; do
        echo "depends = $dep" >> "$BUILDDIR/PKGINFO"
    done
fi

# Add optional dependencies
if [ -n "$optdepends" ]; then
    for optdep in "${optdepends[@]}"; do
        echo "optdepends = $optdep" >> "$BUILDDIR/PKGINFO"
    done
fi

# Add license
if [ -n "$license" ]; then
    for lic in "${license[@]}"; do
        echo "license = $lic" >> "$BUILDDIR/PKGINFO"
    done
fi

# Copy PKGBUILD for reference
cp PKGBUILD "$BUILDDIR/"

# Create files archive
print_info "Creating files archive..."
cd "$PKGDIR"
if command -v zstd &> /dev/null; then
    tar -cf - . | zstd -19 > "$STARTDIR/$BUILDDIR/files.tar.zst"
else
    tar -czf "$STARTDIR/$BUILDDIR/files.tar.gz" .
fi
cd "$STARTDIR"

# Create install script if exists
if [ -f "install.sh" ] || declare -f pre_install > /dev/null || declare -f post_install > /dev/null; then
    print_info "Adding install script..."
    
    if [ -f "install.sh" ]; then
        cp install.sh "$BUILDDIR/"
    else
        # Generate install script from functions
        cat > "$BUILDDIR/install.sh" << 'EOFINSTALL'
#!/bin/bash

pre_install() {
    :
}

post_install() {
    :
}

pre_remove() {
    :
}

post_remove() {
    :
}

case "$1" in
    pre_install)
        pre_install
        ;;
    post_install)
        post_install
        ;;
    pre_remove)
        pre_remove
        ;;
    post_remove)
        post_remove
        ;;
esac
EOFINSTALL
        chmod +x "$BUILDDIR/install.sh"
    fi
fi

# Generate checksums
print_info "Generating checksums..."
cd "$BUILDDIR"
find . -type f ! -name "checksums.sha256" -exec sha256sum {} \; > checksums.sha256
cd "$STARTDIR"

# Create final package
print_info "Creating package archive..."
cd "$BUILDDIR"
tar -czf "$STARTDIR/$PKGFILE" *
cd "$STARTDIR"

# Clean up
rm -rf "$BUILDDIR"

echo ""
print_success "Package built successfully: $PKGFILE"
echo ""

# Install if requested
if [ $INSTALL_AFTER -eq 1 ]; then
    print_info "Installing package..."
    sudo nikaj-pkg install "$PKGFILE"
fi

# Show package info
echo "Package Information:"
echo "  File: $PKGFILE"
echo "  Size: $(du -h "$PKGFILE" | cut -f1)"
echo ""
print_success "Build complete!"
